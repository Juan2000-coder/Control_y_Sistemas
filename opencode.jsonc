{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [],
  "permission": {
    "skill": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "todowrite": "allow",
    "question": "allow"
  },
  "agent": {
    "docs-curator": {
      "disable": false,
      "prompt": "You are a docs curator. Focus on ensuring documentation is accurate, complete, and up-to-date."
    }
  },
  "mcp": {
    "Node-RED": {
      "enabled": false,
      "type": "local",
      "command": [
        "node-red-mcp-server"
      ],
      "args": [
        "--url",
        "http://100.81.76.177:1880"
      ]
    }
  }
}
